# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# browser automation artifacts
.playwright-mcp/

# static export output
/out

# real, uncleared case-study source material and reference docs -- see
# handoff.md. The published site (data/caseStudies.ts) uses placeholder
# copy; none of this should ever go in a commit.
/assets/
/docs/case-studies/
/public/assets/christie-boxer-*
/public/assets/christie-fusion-*
/public/assets/christie-spyder-*
/public/assets/focals-go-compass-concept.png

# local dev journal only -- never for GitHub, not even the private repo
/handoff.md

# scratch workspace for subagent-driven-development plan execution
/.superpowers/
