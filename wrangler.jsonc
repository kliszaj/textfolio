{
  "name": "textfolio",
  // The static Next.js export is served as assets; anything that isn't a file
  // (the typing leaderboard's /api/*) reaches the Worker.
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  // The typing leaderboard (worker/api.ts). Schema in migrations/; apply with
  //   npx wrangler d1 migrations apply textfolio-leaderboard --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "textfolio-leaderboard",
      "database_id": "9997ed48-c0d0-427f-bc69-7c80ff43a069"
    }
  ]
}
