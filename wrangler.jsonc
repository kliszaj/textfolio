{
  "name": "textfolio",
  // The static Next.js export is served as assets; the typing leaderboard's
  // /api/* and the videos reach the Worker (run_worker_first, below).
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-30",
  // Served on the portfolio's own domain (Cloudflare adds the DNS records;
  // the zone's mail records are untouched), as well as workers.dev.
  "routes": [
    { "pattern": "adrianklisz.com", "custom_domain": true },
    { "pattern": "www.adrianklisz.com", "custom_domain": true }
  ],
  // Routes turn workers.dev (and its preview URLs) off unless asked for.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // With a list here, only these reach the Worker at all: everything else is
    // static files, so the leaderboard's API has to be named. Videos come through
    // it to answer the Range requests that seeking needs and static assets
    // ignore (worker/videoRange.ts).
    "run_worker_first": ["/api/*", "/assets/*.mp4"],
    // A bad URL gets the export's 404.html, not an empty response.
    "not_found_handling": "404-page"
  },
  // The typing leaderboard (worker/api.ts). Schema in migrations/; apply with
  //   npx wrangler d1 migrations apply textfolio-leaderboard --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "textfolio-leaderboard",
      "database_id": "9997ed48-c0d0-427f-bc69-7c80ff43a069"
    }
  ]
}
